  "thresholds": {
    "rpm": {
      "enabled": true,
      "unit": "RPM",
      "warning": {
        "max": 1900
      },
      "critical": {
        "max": 2000
      },
      "overspeed": 2200,
      "idle": {
        "min": 650,
        "max": 750
      }
    },
    "manifoldPressure": {
      "enabled": true,
      "unit": "psi",
      "description": "MAP thresholds for naturally aspirated engine - expects vacuum to near-atmospheric",
      "warning": {
        "min": 5,
        "max": 15
      },
      "critical": {
        "min": 3,
        "max": 16
      }
    },
    "tipMapDelta": {
      "enabled": false,
      "description": "TIP/MAP delta monitoring disabled for NA engine - no turbo boost"
    },
    "intakeAirTemp": {
      "enabled": true,
      "unit": "F",
      "description": "IAT thresholds for NA engine",
      "warning": {
        "max": 150
      },
      "critical": {
        "max": 180
      },
      "gracePeriod": 60
    }
  },
  "anomalyRules": [
    {
      "id": "high-map-na",
      "name": "Unexpected High MAP (NA)",
      "description": "MAP pressure unexpectedly high for naturally aspirated engine - check for sensor issue",
      "enabled": true,
      "severity": "warning",
      "category": "pressure",
      "conditions": [
        {
          "param": "MAP",
          "operator": ">",
          "value": 15
        }
      ],
      "requireWhen": [
        {
          "param": "EngineStable",
          "operator": "==",
          "value": 1
        }
      ],
      "triggerPersistenceSec": 5,
      "clearPersistenceSec": 3
    },
    {
      "id": "low-vacuum-na",
      "name": "Low Vacuum at Idle (NA)",
      "description": "Manifold vacuum lower than expected at idle - may indicate vacuum leak or timing issue",
      "enabled": true,
      "severity": "warning",
      "category": "pressure",
      "conditions": [
        {
          "param": "MAP",
          "operator": ">",
          "value": 10
        },
        {
          "param": "TPS",
          "operator": "<",
          "value": 5
        }
      ],
      "logic": "AND",
      "requireWhen": [
        {
          "param": "EngineStable",
          "operator": "==",
          "value": 1
        },
        {
          "param": "rpm",
          "operator": "<",
          "value": 900
        }
      ],
      "triggerPersistenceSec": 10,
      "clearPersistenceSec": 5
    }
  ],
  "metadata": {
    "engineConfig": {
      "displacement": "5.7L",
      "aspiration": "naturally_aspirated",
      "intercooled": false,
      "fullLoadTps": 85,
      "ratedRpm": 1800,
      "idleRpm": 700
    },
    "detectionSignature": {
      "requiredChannels": ["MAP"],
      "excludeChannels": ["TIP", "TIP_press", "BoostPressure", "WG_DC"],
      "mapRange": {
        "max": 15
      }
    }
  }
